{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Paywint API Documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "icon": "rocket",
        "pages": [
          "get-started/overview",
          "get-started/quickstart",
          "get-started/environments",
          "get-started/authentication"
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Authentication",
            "expanded": false,
            "pages": [
              "api-reference/authentication/auth-token"
            ]
          },
          {
            "group": "Users",
            "expanded": false,
            "pages": [
              "api-reference/users/create-user",
              "api-reference/users/list-users",
              "api-reference/users/get-user",
              "api-reference/users/delete-user"
            ]
          },
          {
            "group": "Verification",
            "expanded": false,
            "pages": [
              "api-reference/verification/submit-kyc",
              "api-reference/verification/create-or-resume-kyc-inq",
              "api-reference/verification/sync-kyc-with-persona",
              "api-reference/verification/get-kyc-status",
              "api-reference/verification/submit-kyb",
              "api-reference/verification/get-kyb-status"
            ]
          },
          {
            "group": "Wallets",
            "expanded": false,
            "pages": [
              "api-reference/wallets/get-wallet",
              "api-reference/wallets/get-wallet-activity"
            ]
          },
          {
            "group": "Payment Methods",
            "expanded": false,
            "pages": [
              "api-reference/payments-methods/add-bank-account",
              "api-reference/payments-methods/add-card",
              "api-reference/payments-methods/remove-payment-method",
              "api-reference/payments-methods/list-payment-methods",
              "api-reference/payments-methods/list-bank-payment-methods",
              "api-reference/payments-methods/list-card-payment-methods"
            ]
          },
          {
            "group": "Plaid Bank Linking",
            "expanded": false,
            "pages": [
              "api-reference/plaid-bank-linking/get-plaid-account-balances",
              "api-reference/plaid-bank-linking/exchange-plaid-public-token",
              "api-reference/plaid-bank-linking/get-plaid-account-identity",
              "api-reference/plaid-bank-linking/generate-plaid-link-token",
              "api-reference/plaid-bank-linking/evaluate-ach-risk-via-plaid-signal"
            ]
          }
        ]
      },
      {
        "tab": "Webhooks",
        "icon": "webhook",
        "pages": [
          "webhooks/overview",
          "webhooks/setup",
          "webhooks/signature-verification",
          "webhooks/events",
          "webhooks/event-types",
          "webhooks/retry-behavior"
        ]
      },
      {
        "tab": "Guidelines",
        "icon": "list-check",
        "groups": [
          {
            "group": "URL Standards",
            "pages": [
              "guidelines/url-standards/overview",
              "guidelines/url-standards/basic-requirements",
              "guidelines/url-standards/security-rules",
              "guidelines/url-standards/file-rules",
              "guidelines/url-standards/cloud-storage",
              "guidelines/url-standards/troubleshooting",
              "guidelines/url-standards/examples"
            ]
          }
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": false
  },
  "logo": {
    "light": "/assets/logo/app-logo-dark.png",
    "dark": "/assets/logo/app-logo-light.png"
  },
  "fonts": {
    "family": "Inter",
    "weight": 400
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.paywint.com"
      },
      {
        "label": "Support",
        "href": "mailto:support@paywint.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Developer Docs",
      "href": "https://docs.paywint.com"
    }
  },
  "footer": {
    "socials": {
      "youtube": "https://www.youtube.com/@paywint",
      "facebook": "https://www.facebook.com/paywintonline",
      "instagram": "https://www.instagram.com/paywint",
      "x": "https://x.com/paywint",
      "linkedin": "https://www.linkedin.com/company/paywint",
      "threads": "https://www.threads.net/@paywint"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/get-started/overview"
    }
  ],
  "api": {
    "openapi": {
      "source": "https://api-sandbox.fg.wintpay.com/openapi-platform.json",
      "directory": "api-reference"
    }
  },
  "seo": {
    "indexing": "all"
  }
}
