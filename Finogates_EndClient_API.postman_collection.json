    { "key": "card_acquiring_id", "value": "" },
    { "key": "webhook_id", "value": "" },
    { "key": "webhook_secret", "value": "" },
    { "key": "crypto_wallet_id", "value": "" },
    { "key": "crypto_transfer_id", "value": "" },
    { "key": "crypto_withdrawal_id", "value": "" },
