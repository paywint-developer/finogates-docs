    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Access Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/platform/auth/token", "host": ["{{base_url}}"], "path": ["v1", "platform", "auth", "token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"client_secret\": \"{{client_secret}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data || pm.response.json();",
                  "  pm.collectionVariables.set('access_token', data.access_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
