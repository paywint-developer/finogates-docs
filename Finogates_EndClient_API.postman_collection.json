{
  "info": {
    "name": "Finogates End-Client API",
    "_postman_id": "fg-endclient-2026-05-19",
    "description": "Public platform API for businesses integrating Finogates. OAuth2 client_credentials.\n\nSetup:\n1. Import the Sandbox or Production environment.\n2. Set client_id and client_secret.\n3. Run `Auth > Get Access Token`. Token is stored automatically (24 min TTL).\n4. Mode (sandbox/production) is resolved from the hostname — no header required.\n5. Money is in major units. Money-moving POSTs auto-generate Idempotency-Key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('idempotency_key')) {",
          "  pm.collectionVariables.set('idempotency_key', 'idem-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "idempotency_key", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "wallet_id", "value": "" },
    { "key": "destination_wallet_id", "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "payment_method_id", "value": "" },
